{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "client": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "isFeatured": { "type": "boolean" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "thumbnail": { "type": "string" },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "typography": { "type": "array" },
        "tools": { "type": "array" }
      },
      "required": ["title", "slug", "categoryId", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Project category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Blog article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "categoryId": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["title", "slug", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client feedback",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "content": { "type": "string" },
        "avatar": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["name", "content"]
    },
    "Service": {
      "title": "Service",
      "description": "Offered graphic design service",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "deliverables": { "type": "array" },
        "startingPrice": { "type": "string" }
      },
      "required": ["title", "description"]
    },
    "Message": {
      "title": "Message",
      "description": "Contact form submission",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "replied"] }
      },
      "required": ["name", "email", "message"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "tagline": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "whatsappEnabled": { "type": "boolean" },
        "location": { "type": "string" },
        "workingHours": { "type": "string" },
        "accentColor": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "copyright": { "type": "string" }
      }
    }
  },
  "firestore": {
    "projects": { "schema": "Project", "description": "Portfolio projects collection" },
    "categories": { "schema": "Category", "description": "Project categories collection" },
    "blogPosts": { "schema": "BlogPost", "description": "Blog posts collection" },
    "testimonials": { "schema": "Testimonial", "description": "Client testimonials collection" },
    "services": { "schema": "Service", "description": "Offered services collection" },
    "messages": { "schema": "Message", "description": "Contact form submissions" },
    "settings": { "schema": "Settings", "description": "Configuration singletons" }
  }
}
