rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'mdmahadih673@gmail.com' || request.auth.token.email == 'admin@portfolio.com') && 
        (request.auth.token.email_verified == true || request.auth.token.email == 'admin@portfolio.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test path
    match /test/connection {
      allow read: if true;
    }

    // Admins collection - only readable by signed in users, but specifically for check
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable via console for safety
    }

    // Hero Section
    match /hero/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // About Section
    match /about/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if (resource != null && resource.data.get('status', '') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if (resource != null && resource.data.get('status', '') == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if (resource != null && resource.data.get('status', '') == 'visible') || isAdmin();
      allow write: if isAdmin();
    }

    // Blog
    match /blog/{postId} {
      allow read: if (resource != null && resource.data.get('status', '') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow create: if true; // Anyone can send a message
      allow read, update, delete: if isAdmin();
    }

    // Social Links
    match /socialLinks/{linkId} {
      allow read: if (resource != null && resource.data.get('status', '') == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // Pricing
    match /pricing/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if settingId in ['config', 'hireme'];
      allow write: if isAdmin();
    }
  }
}
